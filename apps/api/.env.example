PORT=3870
DATABASE_URL=postgres://donovan:donovan@localhost:5433/donovan
ELASTICSEARCH_URL=http://localhost:9201
OIDC_ISSUER=http://localhost:8180/realms/donovan
OIDC_AUDIENCE=donovan-api
# Local and CI only: lets end-to-end tests reset their test users.
ALLOW_TEST_RESET=true
# Local and CI: no per-person request limit (end-to-end tests share a few users across parallel tests).
# Production requires one; the default is 600 requests a minute.
RATE_LIMIT_PER_MINUTE=0
# Local and CI: more answers streaming at once per person than the default (3), for parallel end-to-end tests.
MAX_STREAMS_PER_USER=10
