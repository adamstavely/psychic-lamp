{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --config ./vitest.config.int.ts",
    "start:built": "node --env-file-if-exists=.env dist/main.js",
    "migrate": "node --env-file-if-exists=.env dist/migrate.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@donovan/contracts": "*",
    "@elastic/elasticsearch": "^8.19.2",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.1.2",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "drizzle-kit": "^0.31.11",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
