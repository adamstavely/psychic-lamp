{
  "realm": "donovan",
  "enabled": true,
  "displayName": "Donovan (local)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "donovan-admin",
        "description": "Can change Governance policies in Donovan."
      }
    ]
  },
  "clients": [
    {
      "clientId": "donovan-web",
      "name": "Donovan web",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:4200/*", "http://localhost:4620/*"],
      "webOrigins": ["http://localhost:4200", "http://localhost:4620"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*##http://localhost:4620/*"
      },
      "protocolMappers": [
        {
          "name": "donovan-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "donovan-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
