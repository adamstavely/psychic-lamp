# Donovan's web front: the app, and /api passed to the API. ${API_UPSTREAM} and ${OIDC_ORIGIN} are filled in at start
# (15-donovan.sh); everything else with a dollar sign is nginx's own.

# Files whose names carry a content hash are cached for good; everything else is checked each time. (Set here rather
# than with add_header in each location, which would drop the security headers below: nginx doesn't merge them.)
map $uri $dn_cache {
  default "no-cache";
  "~-[A-Za-z0-9_]{8}\.(?:js|css)$" "public, max-age=31536000, immutable";
  ~^/media/ "public, max-age=31536000, immutable";
  ~^/api/ "";
}

server {
  listen 8080;
  server_tokens off;
  root /usr/share/nginx/html;
  client_max_body_size 1m;

  # The app may run scripts and connect only to itself, and to the identity provider for sign-in; nothing frames it.
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ${OIDC_ORIGIN}; frame-src ${OIDC_ORIGIN}; form-action 'self' ${OIDC_ORIGIN}; base-uri 'self'; frame-ancestors 'none'; object-src 'none'" always;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;
  add_header Permissions-Policy "camera=(), geolocation=(), microphone=(self)" always;
  add_header Cache-Control $dn_cache always;

  location = /config.json {
    alias /tmp/donovan/config.json;
  }

  # A missing script or style is a 404, not the app's page.
  location ~* \.(?:js|css|woff2?|svg|png|ico)$ {
    try_files $uri =404;
  }

  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-Id $request_id;
    # Answers stream as server-sent events: pass each event on as it comes, and give a long answer time to finish.
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
  }

  # Everything else is the app, which routes in the browser.
  location / {
    try_files $uri /index.html;
  }
}
